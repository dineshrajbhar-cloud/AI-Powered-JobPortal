# Where the Vite dev server proxies /api to (your Spring Boot app)
VITE_PROXY_TARGET=http://localhost:9090

# Only set this for a production build that calls the API directly
# (requires CORS on the backend). Leave empty to use the /api proxy/reverse proxy.
# VITE_API_URL=https://api.example.com/api

# Show the "Use demo recruiter" shortcut on the login page in production builds
# (it is always shown in `npm run dev`)
# VITE_SHOW_DEMO=true

# Salary formatting
# VITE_CURRENCY_LOCALE=en-IN
# VITE_CURRENCY_CODE=INR
